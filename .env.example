# Spreadsheet ID only (not the full URL) — the part between /d/ and /edit
# e.g. for https://docs.google.com/spreadsheets/d/1IXY4.../edit?gid=0 use "1IXY4..."
SHEET_ID=
# Alternate name accepted by the API (either one works)
GOOGLE_SHEET_ID=

# Option A: compact single-line JSON service account key, must include both
# client_email and private_key. Create with: jq -c . service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY={"client_email":"xyz@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
GOOGLE_SERVICE_ACCOUNT_KEY=

# Option B (recommended): base64 of the same JSON key (keeps newlines safe). Create with:
#   base64 ~/path/to/service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY_B64=

# Optional (default Sheet1!A:E). First row can be headers: Timestamp | StepId | Title | Rating | Comment
# WAITLIST_SHEET_RANGE=Sheet1!A:E

# --- Blog + admin (Supabase) --------------------------------------------------
# Use the SAME Supabase project as the iOS app.
# Dashboard → Project Settings → API. Both values are safe to expose publicly;
# row-level security (see supabase_blog.sql) is what protects the data.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / public key — NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
